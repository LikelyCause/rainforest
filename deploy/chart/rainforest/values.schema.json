{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["hostname"],
  "properties": {
    "hostname": { "type": "string", "minLength": 1 },
    "publicScheme": { "type": "string", "enum": ["", "https", "http"] },
    "clusterDomain": { "type": "string", "minLength": 1 },
    "imagePullSecrets": { "type": "array" },
    "auth": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["pick", "oidc"] }
      }
    },
    "mlflow": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["in-chart", "external", "off"] },
        "experimentPrefix": { "type": "string", "pattern": "^[A-Za-z0-9._/-]*$" }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "external": {
          "type": "object",
          "properties": {
            "managedRoles": { "type": "boolean" }
          }
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "gpu": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "cuda": { "type": "string", "enum": ["", "cuda13", "cu12"] },
            "imageTag": { "type": "string" },
            "count": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "properties": {
        "mongodb": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "existingSecret": { "type": "string" },
              "key": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "keep": { "type": "boolean" }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" }
      }
    }
  }
}
