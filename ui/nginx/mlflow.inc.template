# Rendered at container start when MLFLOW_ENABLED=1, otherwise the include stays empty. Only the two upstreams
# are substituted.

# MLflow tracking UI, behind the Rainforest session.
location /mlflow/ {
    auth_request /_auth;
    error_page 401 = @signin;
    set $mlflow ${MLFLOW_UPSTREAM};
    proxy_pass $mlflow;
    proxy_http_version 1.1;
    # MLflow only accepts its own host name; cross-site requests never get past auth_request
    # (the session cookie is SameSite=Strict), so its Origin check is not needed here.
    proxy_set_header Host mlflow;
    proxy_set_header Origin "";
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_read_timeout 600s;
}

location = /_auth {
    internal;
    set $api ${API_UPSTREAM};
    proxy_pass $api/api/auth/check;
    proxy_method GET;
    # The API judges the request this check stands for: a viewer may browse MLflow but not change it.
    proxy_set_header X-Original-Method $request_method;
    proxy_set_header X-Original-URI $request_uri;
    proxy_pass_request_body off;
    proxy_set_header Transfer-Encoding "";
    proxy_set_header Content-Length "";
    proxy_set_header Host $http_host;
}

location @signin {
    # Relative, so the browser keeps the host port nginx can't see (e.g. 8080 mapped to 80).
    absolute_redirect off;
    return 302 /login?next=/mlflow/;
}
