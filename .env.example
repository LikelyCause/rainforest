# Copy to .env and adjust. Everything has a default in docker-compose.yml.

# Sign-in (README › Sign-in). "pick" lists users to choose from and does NOT authenticate: dev, demos, one person.
# Team deployments use "oidc" with the settings below.
RAINFOREST_AUTH_MODE=pick
# RAINFOREST_OIDC_ISSUER=https://sso.example.com/realms/rainforest
# RAINFOREST_OIDC_CLIENT_ID=rainforest
# RAINFOREST_OIDC_CLIENT_SECRET=
# RAINFOREST_OIDC_REDIRECT_URL=https://rainforest.example.com/api/auth/oidc/callback
# RAINFOREST_OIDC_PROVIDER_NAME=SSO
# RAINFOREST_OIDC_GROUPS_CLAIM=groups
# RAINFOREST_LEAD_GROUP=rainforest-lead
# RAINFOREST_MEMBER_GROUP=rainforest-member
# Only when the API can't reach the issuer URL itself:
# RAINFOREST_OIDC_DISCOVERY_URL=
# Signs session cookies. Leave empty to generate one, kept in the data volume.
RAINFOREST_SESSION_SECRET=
# Hostnames / IPs the API answers to, comma-separated (e.g. rainforest.lan,192.168.1.20).
# "*" accepts any; set it to yours. localhost is always accepted.
RAINFOREST_ALLOWED_HOSTS=*

POSTGRES_DB=rainforest
POSTGRES_USER=rainforest
POSTGRES_PASSWORD=change-me
# Password for the SELECT-only role used by the UI's SQL console.
READONLY_PASSWORD=change-me-too


UI_PORT=8080
API_PORT=8000
DB_PORT=5432

API_WORKERS=2
JOB_WORKERS=2
# Background jobs running at once across all API workers.
JOB_SLOTS=2
LOG_LEVEL=info

# API tuning (README › Configuration); uncomment to change a default.
# PROFILE_SAMPLE_ROWS=500000
# CORR_SAMPLE_ROWS=100000
# CORR_MAX_LEVELS=50
# COPY_BATCH_ROWS=100000
# EXPORT_CHUNK_MB=256
# EXPORT_FIT_MB=512
# SAMPLE_MAX_CELLS=60000000
# DB_POOL_MAX=10
# SQL_TIMEOUT_MS=15000
# SQL_MAX_ROWS=2000
# SQL_POOL_MAX=4

# Extra pip packages baked into the API image, e.g. "catboost"
API_EXTRA_PIP=

# Keycloak reference setup only (make up-keycloak): the URLs browsers use for Keycloak and for Rainforest.
# KEYCLOAK_URL=http://localhost:8081
# RAINFOREST_URL=http://localhost:8080
# KEYCLOAK_PORT=8081
# KEYCLOAK_ADMIN_PASSWORD=admin

# GPU image only (make up-gpu): the CUDA XGBoost package. Default xgboost==3.4.1 (CUDA 13, driver 580+);
# use xgboost-cu12==3.4.1 with a 570-579 driver.
XGBOOST_GPU_PKG=
