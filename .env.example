# Copy to .env and adjust. Every value has a default in docker-compose.yml.
POSTGRES_DB=rainforest
POSTGRES_USER=rainforest
POSTGRES_PASSWORD=change-me
# Password for the SELECT-only role used by the UI's SQL console.
READONLY_PASSWORD=change-me-too


UI_PORT=8080
API_PORT=8000
DB_PORT=5432

API_WORKERS=2
JOB_WORKERS=2
# Background jobs running at once across all API workers.
JOB_SLOTS=2
LOG_LEVEL=info

# Extra pip packages baked into the API image (enables optional models), e.g. "xgboost"
API_EXTRA_PIP=
