# Copy to .env and adjust. Compose reads .env on every command (`make up` is `docker compose up -d --build`), so it
# is the deployment's whole configuration. Everything has a default in docker-compose.yml. Write a literal $ as $$.

# Sign-in (docs/deployment.md › Sign-in). Unset, it is "pick": the sign-in page lists users to choose from and does NOT
# authenticate (dev, demos, one person). Team deployments use "oidc"; see the team deployment block below.
# RAINFOREST_AUTH_MODE=pick
# Pick mode's accounts, "key[#id]:Name:role;…" with roles lead, member or viewer. When set it is the whole list:
# accounts not in it are deactivated (never deleted) and can't be edited in the app. "#id" (first sync only) gives an
# existing account this key, keeping its history.
# RAINFOREST_USERS=tanner:Tanner:lead;test-member:Test Member:member;test-viewer:Test Viewer:viewer
# RAINFOREST_OIDC_ISSUER=https://sso.example.com/realms/rainforest
# RAINFOREST_OIDC_CLIENT_ID=rainforest
# RAINFOREST_OIDC_CLIENT_SECRET=
# RAINFOREST_OIDC_REDIRECT_URL=https://rainforest.example.com/api/auth/oidc/callback
# RAINFOREST_OIDC_PROVIDER_NAME=SSO
# RAINFOREST_OIDC_SCOPES=openid profile email
# RAINFOREST_OIDC_GROUPS_CLAIM=groups
# RAINFOREST_LEAD_GROUP=rainforest-lead
# RAINFOREST_MEMBER_GROUP=rainforest-member
# Only when the API can't reach the issuer URL itself:
# RAINFOREST_OIDC_DISCOVERY_URL=
# Signs session cookies. Leave empty to generate one, kept in the data volume.
RAINFOREST_SESSION_SECRET=
# Hostnames / IPs the API answers to, comma-separated (e.g. rainforest.lan,192.168.1.20).
# "*" accepts any; set it to yours. localhost is always accepted.
RAINFOREST_ALLOWED_HOSTS=*

POSTGRES_DB=rainforest
POSTGRES_USER=rainforest
POSTGRES_PASSWORD=change-me
# Password for the SELECT-only role used by the UI's SQL console.
READONLY_PASSWORD=change-me-too

UI_PORT=8080
API_PORT=8000
DB_PORT=5432

API_WORKERS=2
JOB_WORKERS=2
# Background jobs running at once across all API workers; each gets cpu_count // JOB_SLOTS threads. The rest queue.
JOB_SLOTS=1
LOG_LEVEL=info

# API tuning (docs/configuration.md); uncomment to change a default.
# PROFILE_SAMPLE_ROWS=500000
# CORR_SAMPLE_ROWS=100000
# CORR_MAX_LEVELS=50
# COPY_BATCH_ROWS=100000
# EXPORT_CHUNK_MB=256
# EXPORT_FIT_MB=512
# SAMPLE_MAX_CELLS=60000000
# DB_POOL_MAX=10
# SQL_TIMEOUT_MS=15000
# SQL_MAX_ROWS=2000
# SQL_POOL_MAX=4

# MLflow tracking (docs/mlflow.md). Unset: the compose mlflow service at http://mlflow:5000/mlflow.
# Set it empty to turn logging off.
# MLFLOW_TRACKING_URI=
# The address browsers open MLflow at, when it isn't the compose server behind /mlflow/ (an existing MLflow server).
# MLFLOW_BROWSE_URL=
# Commit tagged on MLflow runs; `make up` sets it from the checkout.
# GIT_SHA=

# Extra pip packages baked into the API image, e.g. "catboost"
API_EXTRA_PIP=

# Team deployment (docs/deployment.md › Team deployment checklist): uncomment what applies, then `make up`.
# The reference Keycloak (dev-only) as the provider; KEYCLOAK_URL and RAINFOREST_URL are the URLs browsers use.
# COMPOSE_PROFILES=keycloak
# KEYCLOAK_URL=http://rainforest.lan:8081
# RAINFOREST_URL=http://rainforest.lan:8080
# KEYCLOAK_PORT=8081
# KEYCLOAK_ADMIN_PASSWORD=admin
# RAINFOREST_AUTH_MODE=oidc
# RAINFOREST_OIDC_PROVIDER_NAME=Keycloak
# RAINFOREST_OIDC_ISSUER=http://rainforest.lan:8081/realms/rainforest
# RAINFOREST_OIDC_DISCOVERY_URL=http://keycloak:8080/realms/rainforest/.well-known/openid-configuration
# RAINFOREST_OIDC_CLIENT_ID=rainforest
# RAINFOREST_OIDC_CLIENT_SECRET=rainforest-dev-secret
# RAINFOREST_OIDC_REDIRECT_URL=http://rainforest.lan:8080/api/auth/oidc/callback
# The CUDA XGBoost image, on a host with an NVIDIA GPU (docs/deployment.md › GPU):
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# With a 570-579 driver; the default xgboost==3.4.1 is CUDA 13 and needs driver 580+:
# XGBOOST_GPU_PKG=xgboost-cu12==3.4.1
# Also set RAINFOREST_ALLOWED_HOSTS above to the names and addresses people use.
